<ui:FluentWindow x:Class="OmenSuperHub.Views.PipelineEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:OmenSuperHub"
        Title="{x:Static app:Strings.AutomationEditPipeline}" Width="560" Height="620"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="Transparent">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ponytail: Title 只给窗口/任务栏;实际渲染的是 Header —— 图标+标题自排才能控间距。
         Header 必须 IsHitTestVisible=False,否则 TitleBar 认为鼠标压在内容上,不发 HTCAPTION,拖不动。 -->
    <ui:TitleBar Style="{StaticResource OmenDialogTitleBar}" Grid.Row="0" x:Name="DialogTitleBar" Title="{x:Static app:Strings.AutomationEditPipeline}"
                 ShowMinimize="False" ShowMaximize="False" ShowClose="True" CanMaximize="False">
      <ui:TitleBar.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
          <ui:SymbolIcon Symbol="Flow24" FontSize="{DynamicResource FontSizeSubheader}"
                         Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{x:Static app:Strings.AutomationEditPipeline}" FontSize="{DynamicResource FontSizeTitle}"
                     FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </ui:TitleBar.Header>
    </ui:TitleBar>

    <!-- Scrollable content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  Margin="16,8,16,0">
      <StackPanel Margin="0,0,0,12">

        <!-- Pipeline Name Card -->
        <Border Style="{StaticResource OmenListCard}" Padding="12,14" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static app:Strings.AutomationPipelineName}"
                       FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Grid.Column="1" Height="38" MinWidth="220"
                     FontSize="{DynamicResource FontSizeTitle}" VerticalContentAlignment="Center"/>
          </Grid>
        </Border>

        <!-- Triggers -->
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TriggersHeading" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <ui:Button x:Name="AddTriggerBtn" Grid.Column="1" MinWidth="90" Height="32"
                     Padding="8,0" FontSize="{DynamicResource FontSizeCaption}" Click="AddTriggerBtn_Click"/>
        </Grid>

        <StackPanel x:Name="TriggersPanel" Margin="0,0,0,4"/>

        <!-- Steps -->
        <Grid Margin="0,16,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StepsHeading" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <ui:Button x:Name="AddStepBtn" Grid.Column="1" MinWidth="90" Height="32"
                     Padding="8,0" FontSize="{DynamicResource FontSizeCaption}" Click="AddStepBtn_Click"/>
        </Grid>

        <StackPanel x:Name="StepsPanel" Margin="0,0,0,4"/>

      </StackPanel>
    </ScrollViewer>

    <!-- Button bar -->
    <Border Grid.Row="2"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
            Padding="16,8">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button x:Name="SaveBtn" MinWidth="90" Height="32" Appearance="Primary"
                   Margin="0,0,8,0" Padding="16,0" Click="SaveBtn_Click"/>
        <ui:Button x:Name="CancelBtn" MinWidth="90" Height="32"
                   Padding="16,0" Click="CancelBtn_Click"/>
      </StackPanel>
    </Border>

  </Grid>
</ui:FluentWindow>
