<Window x:Class="OmenSuperHub.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	        xmlns:app="clr-namespace:OmenSuperHub"
	        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Left="0" Top="0">
  <Window.Resources>
    <!-- ponytail: 文字描边 — 零偏移+微模糊的对称光晕轮廓(取代原 315° 投射阴影:
         方向感投影显脏显重;描边在任何桌面底色上保可读)。frozen+Shared,全 TextBlock 复用一份。 -->
    <DropShadowEffect x:Key="TextShadow" Color="Black" Opacity="0.9"
                      ShadowDepth="0" BlurRadius="1.5" Direction="0"
                      x:Shared="True"/>
    <Style TargetType="TextBlock">
      <Setter Property="Effect" Value="{StaticResource TextShadow}"/>
    </Style>
  </Window.Resources>

  <Grid Background="Transparent" MouseLeftButtonDown="ContentBorder_MouseLeftButtonDown">
    <!-- ponytail: no background — text floats on desktop directly -->
    <Border CornerRadius="4" Padding="4">
      <!-- ponytail: StackPanel 横排时每项数据 TextBlock 由 .cs 里给的固定 em-width 占位,数字位数变化不再挤动整窗 -->
      <StackPanel x:Name="DataPanel" HorizontalAlignment="Left">
        <!-- ponytail: separator `|` lives inside each row so it hides when the row is collapsed -->
        <!-- CPU Row -->
        <StackPanel x:Name="CpuRow" Orientation="Horizontal" Margin="0">
	          <TextBlock Text="{x:Static app:Strings.FloatLabelCpu}" FontFamily="{DynamicResource MonoFontFamily}"
                     FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeSubtitle}"
                     Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center" x:Name="CpuLabel"/>
          <StackPanel x:Name="CpuDataStack" Orientation="Vertical" Margin="4,0,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="CpuTempText" FontFamily="{DynamicResource MonoFontFamily}"
                         FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                         Foreground="#FF6B6B" VerticalAlignment="Center"/>
              <TextBlock x:Name="CpuPowerText" FontFamily="{DynamicResource MonoFontFamily}"
                         FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                         Foreground="#FFB347" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="CpuLine2" Orientation="Horizontal">
              <TextBlock x:Name="CpuUsageText" FontFamily="{DynamicResource MonoFontFamily}"
                         FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                         Foreground="#66BB6A" VerticalAlignment="Center"/>
              <TextBlock x:Name="CpuFreqText" FontFamily="{DynamicResource MonoFontFamily}"
                         FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                         Foreground="#CE93D8" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="Sep1" Text=" | " FontFamily="{DynamicResource MonoFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                     Foreground="#888" VerticalAlignment="Center" Margin="2,0" Visibility="Collapsed"/>
        </StackPanel>
        <!-- GPU Row -->
        <StackPanel x:Name="GpuRow" Orientation="Horizontal" Margin="0">
	          <TextBlock Text="{x:Static app:Strings.FloatLabelGpu}" FontFamily="{DynamicResource MonoFontFamily}"
                     FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeSubtitle}"
                     Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center" x:Name="GpuLabel"/>
          <StackPanel x:Name="GpuDataStack" Orientation="Vertical" Margin="4,0,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="GpuTempText" FontFamily="{DynamicResource MonoFontFamily}"
                         FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                         Foreground="#FF6B6B" VerticalAlignment="Center"/>
              <TextBlock x:Name="GpuPowerText" FontFamily="{DynamicResource MonoFontFamily}"
                         FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                         Foreground="#FFB347" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="GpuLine2" Orientation="Horizontal">
              <TextBlock x:Name="GpuUsageText" FontFamily="{DynamicResource MonoFontFamily}"
                         FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                         Foreground="#66BB6A" VerticalAlignment="Center"/>
              <TextBlock x:Name="GpuFreqText" FontFamily="{DynamicResource MonoFontFamily}"
                         FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                         Foreground="#CE93D8" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="Sep2" Text=" | " FontFamily="{DynamicResource MonoFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                     Foreground="#888" VerticalAlignment="Center" Margin="2,0" Visibility="Collapsed"/>
        </StackPanel>
        <!-- Memory Row -->
        <StackPanel x:Name="MemRow" Orientation="Horizontal" Margin="0">
	          <TextBlock Text="{x:Static app:Strings.FloatLabelMem}" FontFamily="{DynamicResource MonoFontFamily}"
                     FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeSubtitle}"
                     Foreground="#66BB6A" VerticalAlignment="Center" x:Name="MemLabel"/>
          <StackPanel x:Name="MemDataStack" Orientation="Vertical" Margin="4,0,0,0">
            <TextBlock x:Name="MemPctText" FontFamily="{DynamicResource MonoFontFamily}"
                       FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                       Foreground="#66BB6A" VerticalAlignment="Center"/>
            <TextBlock x:Name="MemUsedText" FontFamily="{DynamicResource MonoFontFamily}"
                       FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                       Foreground="#FFB347" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="Sep3" Text=" | " FontFamily="{DynamicResource MonoFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                     Foreground="#888" VerticalAlignment="Center" Margin="2,0" Visibility="Collapsed"/>
        </StackPanel>
        <!-- Network Row -->
        <StackPanel x:Name="NetRow" Orientation="Horizontal" Margin="0">
	          <TextBlock Text="{x:Static app:Strings.FloatLabelNet}" FontFamily="{DynamicResource MonoFontFamily}"
                     FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeSubtitle}"
                     Foreground="#4DD0E1" VerticalAlignment="Center" x:Name="NetLabel"/>
          <StackPanel x:Name="NetDataStack" Orientation="Vertical" Margin="4,0,0,0">
            <TextBlock x:Name="NetDownText" FontFamily="{DynamicResource MonoFontFamily}"
                       FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                       Foreground="#66BB6A" VerticalAlignment="Center"/>
            <TextBlock x:Name="NetUpText" FontFamily="{DynamicResource MonoFontFamily}"
                       FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                       Foreground="#FFB347" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="Sep4" Text=" | " FontFamily="{DynamicResource MonoFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                     Foreground="#888" VerticalAlignment="Center" Margin="2,0" Visibility="Collapsed"/>
        </StackPanel>
        <!-- FPS Row -->
        <StackPanel x:Name="FpsRow" Orientation="Horizontal" Margin="0">
	          <TextBlock Text="{x:Static app:Strings.FloatLabelFps}" FontFamily="{DynamicResource MonoFontFamily}"
                     FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeSubtitle}"
                     Foreground="#FF9800" VerticalAlignment="Center" x:Name="FpsLabel"/>
          <!-- ponytail: FPS value 一行, 1%低帧 + 应用名一行。多值的那一行按本文件既有写法
               用横向 StackPanel 包起来(同 CpuLine2/GpuLine2), col/row 两种布局都不用特判。
               低帧无数据(刚起来还没攒够窗口)时文本为空, 空 TextBlock 不占宽。 -->
          <StackPanel x:Name="FpsDataStack" Orientation="Vertical" Margin="4,0,0,0">
            <TextBlock x:Name="FpsValueText" FontFamily="{DynamicResource MonoFontFamily}"
                       FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                       Foreground="#FF9800" VerticalAlignment="Center"/>
            <StackPanel x:Name="FpsLine2" Orientation="Horizontal">
              <TextBlock x:Name="FpsLowText" FontFamily="{DynamicResource MonoFontFamily}"
                         FontWeight="Bold" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="#FFB347" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <TextBlock x:Name="FpsAppText" FontFamily="{DynamicResource MonoFontFamily}"
                         FontWeight="Bold" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="#AAA" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="Sep5" Text=" | " FontFamily="{DynamicResource MonoFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                     Foreground="#888" VerticalAlignment="Center" Margin="2,0" Visibility="Collapsed"/>
        </StackPanel>
        <!-- Fan Row (last row — no trailing separator) -->
        <StackPanel x:Name="FanRow" Orientation="Horizontal" Margin="0">
	          <TextBlock Text="{x:Static app:Strings.FloatLabelFan}" FontFamily="{DynamicResource MonoFontFamily}"
                     FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeSubtitle}"
                     Foreground="#4FC3F7" VerticalAlignment="Center" x:Name="FanLabel"/>
          <StackPanel x:Name="FanDataStack" Orientation="Vertical" Margin="4,0,0,0">
            <TextBlock x:Name="FanSpeed0Text" FontFamily="{DynamicResource MonoFontFamily}"
                       FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                       Foreground="#66BB6A" VerticalAlignment="Center"/>
            <TextBlock x:Name="FanSpeed1Text" FontFamily="{DynamicResource MonoFontFamily}"
                       FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                       Foreground="#FFB347" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
