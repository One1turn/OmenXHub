<ui:FluentWindow x:Class="OmenSuperHub.Views.LanShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:OmenSuperHub"
        Title="{x:Static app:Strings.LanShareTitle}" Width="420" SizeToContent="Height"
        MinWidth="380" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Topmost="True"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True" Background="Transparent">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ponytail: ExtendsContentIntoTitleBar 会去掉原生标题栏,必须显式给 ui:TitleBar,
         否则窗口无关闭键(ShowClose 提供关闭按钮 + 拖拽区)。 -->
    <ui:TitleBar Style="{StaticResource OmenDialogTitleBar}" Grid.Row="0" Title="{x:Static app:Strings.LanShareTitle}"
                 ShowMinimize="False" ShowMaximize="False" ShowClose="True" CanMaximize="False">
      <ui:TitleBar.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
          <ui:SymbolIcon Symbol="QrCode24" FontSize="{DynamicResource FontSizeSubheader}"
                         Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{x:Static app:Strings.LanShareTitle}" FontSize="{DynamicResource FontSizeTitle}"
                     FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </ui:TitleBar.Header>
    </ui:TitleBar>

    <StackPanel Grid.Row="1" Margin="16,16,16,16" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <TextBlock x:Name="HintText" Text="{x:Static app:Strings.LanShareHint}" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

    <!-- 多网卡(USB 共享/Wi-Fi 同连)时供选择目标网络; 单候选自动隐藏 -->
    <ComboBox x:Name="NicPicker" Margin="0,0,0,12" SelectionChanged="NicPicker_Changed"/>

    <Border x:Name="QrBorder" HorizontalAlignment="Center" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,12">
      <Image x:Name="QrImage" Width="220" Height="220" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="LinkBox" Grid.Column="0" IsReadOnly="True" FontSize="{DynamicResource FontSizeCaption}"
               TextWrapping="NoWrap" VerticalContentAlignment="Center" Padding="8,6"/>
      <ui:Button x:Name="CopyButton" Grid.Column="1" Content="{x:Static app:Strings.LanCopyLink}"
                 Click="Copy_Click" Margin="8,0,0,0" MinWidth="88" Height="32"/>
    </Grid>

    <!-- ponytail: 令牌设置原来是「复选框 + 按钮 + 状态文字」三行裸控件,与上方的二维码区
         没有分界。收进一张卡:复选框与重置按钮同行(左说明右动作),状态文字压在卡下方。 -->
    <Border Style="{StaticResource OmenListCard}" Padding="12,10" Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <CheckBox x:Name="PersistentTokenCheck" Content="{x:Static app:Strings.LanTokenLabel}"
                  VerticalAlignment="Center"
                  Checked="PersistentToken_Changed" Unchecked="PersistentToken_Changed"/>
        <TextBlock Grid.Row="1" Text="{x:Static app:Strings.LanTokenHint}"
                   FontSize="{DynamicResource FontSizeCaption}" Margin="24,2,8,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        <ui:Button Grid.Column="1" Grid.RowSpan="2" x:Name="ResetTokenButton"
                   Content="{x:Static app:Strings.LanResetToken}"
                   Click="ResetToken_Click" Margin="12,0,0,0" Height="32" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <TextBlock x:Name="StatusText" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource AccentYellowBrush}"
               TextWrapping="Wrap" Margin="2,8,0,0"/>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
