<Window x:Class="OmenSuperHub.Views.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	        xmlns:app="clr-namespace:OmenSuperHub"
	        xmlns:controls="clr-namespace:OmenSuperHub.Controls"
	        Width="328"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" SizeToContent="Height"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="IconAccentBrush" Color="{DynamicResource AccentOmen}"/>
  </Window.Resources>

  <!-- ponytail: 外层 Grid Margin=24 给阴影留白(窗口随之 280→328);背景+阴影放兄弟 Border,
       正文 Border 独立不挂 Effect → 内部文字保住 ClearType。 -->
  <Grid Margin="24">
    <!-- 背景/圆角/阴影层(仅此层被栅格化) -->
    <Border CornerRadius="8"
            Background="{DynamicResource ContextMenuBackground}"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="32" Direction="270"
                          Opacity="0.28" ShadowDepth="8"
                          Color="#000000"/>
      </Border.Effect>
    </Border>
    <!-- 正文层(透明,无 Effect,保 ClearType) -->
    <Border CornerRadius="8">
    <StackPanel>

      <!-- ── Header ── -->
	      <TextBlock Text="{x:Static app:Strings.TrayHeader}"
                 FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Margin="16,14,16,0"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
      <TextBlock x:Name="PresetText"
                 FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                 Margin="16,2,16,0"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Microsoft YaHei UI, Segoe UI"/>

      <!-- ── Divider ── -->
      <Border Height="1" Margin="16,12,16,0"
              Background="{DynamicResource ControlElevationBorderBrush}"/>

      <!-- ── Metrics Grid ── -->
      <Grid Margin="16,12,16,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Performance Mode -->
        <ui:SymbolIcon Grid.Row="0" Grid.Column="0"
                       Symbol="Gauge24" FontSize="20"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource IconAccentBrush}"/>
        <TextBlock Grid.Row="0" Grid.Column="1"
                   x:Name="PerfModeLabel"
                   FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Medium"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <TextBlock x:Name="PresetValueText"
                   Grid.Row="0" Grid.Column="2"
                   FontSize="{DynamicResource FontSizeSubtitle}"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <!-- CPU -->
        <ui:SymbolIcon x:Name="CpuIcon"
                       Grid.Row="1" Grid.Column="0"
                       Symbol="DeveloperBoard24" FontSize="20"
                       VerticalAlignment="Center" Margin="0,8,0,0"
                       Foreground="{StaticResource IconAccentBrush}"/>
	        <TextBlock x:Name="CpuLabel"
		                   Grid.Row="1" Grid.Column="1"
		                   Text="{x:Static app:Strings.MonitorCpuLabel}"
                   FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Medium"
                   VerticalAlignment="Center"
                   Margin="10,8,0,0"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <TextBlock x:Name="CpuValueText"
                   Grid.Row="1" Grid.Column="2"
                   FontSize="{DynamicResource FontSizeSubtitle}"
                   VerticalAlignment="Center"
                   Margin="12,8,0,0"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <!-- GPU -->
        <!-- ponytail: Video24 是摄像机图形,和 GPU 无关。改用 DashboardPage:169(GPU 卡头)/
             PerfPage:739(GPU 组头)同款 DeviceEq24 —— 全仓的 GPU 语义图标就这一个。 -->
        <ui:SymbolIcon x:Name="GpuIcon"
                       Grid.Row="2" Grid.Column="0"
                       Symbol="DeviceEq24" FontSize="20"
                       VerticalAlignment="Center" Margin="0,8,0,0"
                       Foreground="{StaticResource IconAccentBrush}"/>
	        <TextBlock x:Name="GpuLabel"
		                   Grid.Row="2" Grid.Column="1"
		                   Text="{x:Static app:Strings.MonitorGpuLabel}"
                   FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Medium"
                   VerticalAlignment="Center"
                   Margin="10,8,0,0"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <TextBlock x:Name="GpuValueText"
                   Grid.Row="2" Grid.Column="2"
                   FontSize="{DynamicResource FontSizeSubtitle}"
                   VerticalAlignment="Center"
                   Margin="12,8,0,0"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <!-- Fan -->
        <!-- ponytail: 用侧栏同一个 controls:FanIcon(与 NavFan 同源),不再是 Pulse24 —— 心率波形
             和风扇没有语义关系,侧栏已用弯刀叶片图标,此处对齐。IconElement 无 FontSize,改用 IconSize。 -->
        <controls:FanIcon x:Name="FanIcon"
                          Grid.Row="3" Grid.Column="0"
                          IconSize="20"
                          VerticalAlignment="Center" Margin="0,8,0,0"
                          Foreground="{StaticResource IconAccentBrush}"/>
        <TextBlock x:Name="FanLabelText"
                   Grid.Row="3" Grid.Column="1"
                   FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Medium"
                   VerticalAlignment="Center"
                   Margin="10,8,0,0"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <TextBlock x:Name="FanValueText"
                   Grid.Row="3" Grid.Column="2"
                   FontSize="{DynamicResource FontSizeSubtitle}"
                   VerticalAlignment="Center"
                   Margin="12,8,0,0"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

      </Grid>
    </StackPanel>
    </Border>
  </Grid>
</Window>
