<ui:FluentWindow x:Class="OmenSuperHub.Views.SystemOptimizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:OmenSuperHub"
        Title="{x:Static app:Strings.SysOptWindowTitle}" Width="680" Height="660"
        MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="Transparent">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ponytail: Title 只给窗口/任务栏;实际渲染的是 Header —— 图标+标题自排才能控间距。
         Header 必须 IsHitTestVisible=False,否则 TitleBar 认为鼠标压在内容上,不发 HTCAPTION,拖不动。 -->
    <ui:TitleBar Style="{StaticResource OmenDialogTitleBar}" Grid.Row="0" Title="{x:Static app:Strings.SysOptWindowTitle}"
                 ShowMinimize="False" ShowMaximize="False" ShowClose="True" CanMaximize="False">
      <ui:TitleBar.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
          <ui:SymbolIcon Symbol="Settings24" FontSize="{DynamicResource FontSizeSubheader}"
                         Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{x:Static app:Strings.SysOptWindowTitle}" FontSize="{DynamicResource FontSizeTitle}"
                     FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </ui:TitleBar.Header>
    </ui:TitleBar>

    <TabControl Grid.Row="1" x:Name="MainTabs" Margin="16,4,16,0" SelectionChanged="TabControl_SelectionChanged">
      <!-- 服务 -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Server24" FontSize="{DynamicResource FontSizeTitle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Static app:Strings.SysOptServicesTab}"/>
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- ponytail: 这段说明原来是一整行长文(11px),挤在页签与搜索框之间像免责声明。
               拆成"一句话说明 + 三个启动类型各自的含义",用次级色分行,扫读成本低得多。 -->
          <StackPanel Grid.Row="0" Margin="2,0,0,10">
            <TextBlock Text="{x:Static app:Strings.SysOptServicesHint}" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Static app:Strings.SysOptStartupLegend}" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
          </StackPanel>
          <!-- ponytail: 服务动辄 200+,没有搜索基本无法定位 —— 按显示名/服务名过滤,
               右侧计数让"筛掉后还剩多少"一目了然。 -->
          <Grid Grid.Row="1" Margin="2,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="ServiceSearchBox" Grid.Column="0"
                        PlaceholderText="{x:Static app:Strings.SysOptSearchPlaceholder}"
                        Icon="Search24" ClearButtonEnabled="True"
                        TextChanged="ServiceSearch_Changed"/>
            <TextBlock x:Name="ServiceCountText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </Grid>
          <!-- ponytail: 315 个服务平铺滚动既难找也慢 —— 改分页,每页 8 行;
               搜索先过滤再分页。ListBox 的 Padding 给右侧滚动条留出 12px 间距,
               避免细滚动条压在 ComboBox 边上。 -->
          <Grid Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" x:Name="ServiceEmptyHint" Visibility="Collapsed"
                     Style="{StaticResource OmenEmptyState}" Margin="0,24,12,24"/>
          <ListBox Grid.Row="0" x:Name="ServiceList" Background="Transparent" BorderThickness="0"
                   Padding="0,0,12,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingStackPanel.IsVirtualizing="True"
                   VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter/>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                  <Border Style="{StaticResource OmenListCard}" Padding="10,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0"
                              VerticalAlignment="Center">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentYellowBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding State}" Value="Running">
                                <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding State}" Value="Stopped">
                                <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <Grid Margin="0,2,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{DynamicResource FontSizeCaption}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     TextTrimming="CharacterEllipsis"/>
                          <!-- ponytail: 只有颜色点时"灰点=已停止"要靠猜;补一枚文字状态徽章 -->
                          <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                  CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StateText}" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                          </Border>
                        </Grid>
                      </StackPanel>
                      <ComboBox Grid.Column="2" Width="110" Margin="8,0,0,0" VerticalAlignment="Center"
                                IsEnabled="{Binding CanChange}"
                                SelectedIndex="{Binding StartupTypeIndex, Mode=OneWay}"
                                SelectionChanged="ServiceType_SelectionChanged"
                                Tag="{Binding}">
                        <ComboBoxItem Content="{x:Static app:Strings.SysOptStartupAuto}"/>
                        <ComboBoxItem Content="{x:Static app:Strings.SysOptStartupManual}"/>
                        <ComboBoxItem Content="{x:Static app:Strings.SysOptStartupDisabled}"/>
                      </ComboBox>
                    </Grid>
                  </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="1" x:Name="ServicePager" Margin="0,6,12,0" Visibility="Collapsed">
            <ui:Button x:Name="ServicePrevBtn" Content="{x:Static app:Strings.SysOptPrevPage}"
                       Appearance="Secondary" Height="28" Padding="12,0" HorizontalAlignment="Left"
                       Click="ServicePrev_Click"/>
            <TextBlock x:Name="ServicePageText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ui:Button x:Name="ServiceNextBtn" Content="{x:Static app:Strings.SysOptNextPage}"
                       Appearance="Secondary" Height="28" Padding="12,0" HorizontalAlignment="Right"
                       Click="ServiceNext_Click"/>
          </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <!-- 启动项 -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Power24" FontSize="{DynamicResource FontSizeTitle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Static app:Strings.SysOptStartupTab}"/>
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{x:Static app:Strings.SysOptStartupHint}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,6"
                     TextWrapping="Wrap"/>
          <Grid Grid.Row="1">
          <TextBlock x:Name="StartupEmptyHint" Visibility="Collapsed"
                     Style="{StaticResource OmenEmptyState}" Margin="0,24,12,24"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <ItemsControl x:Name="StartupList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource OmenListCard}" Padding="10,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                          <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                  CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Location}" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Command}" FontSize="{DynamicResource FontSizeCaption}" MaxWidth="420"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      </StackPanel>
                      <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                       IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                       Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"
                                       Tag="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Grid>
        </Grid>
      </TabItem>

      <!-- 通用优化 -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Settings24" FontSize="{DynamicResource FontSizeTitle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Static app:Strings.SysOptTweaksTab}"/>
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{x:Static app:Strings.SysOptTweaksHint}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,6"
                     TextWrapping="Wrap"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <ItemsControl x:Name="TweakList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource OmenListCard}" Padding="10,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>
                          <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                  CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding RestartVisible}">
                            <TextBlock Text="{x:Static app:Strings.SysOptTweakNeedsRestart}" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="{DynamicResource FontSizeCaption}" MaxWidth="420"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding StateText}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                                   Foreground="{Binding StateBrush}" Margin="0,2,0,0"/>
                      </StackPanel>
                      <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                       IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                       Checked="TweakToggle_Changed" Unchecked="TweakToggle_Changed"
                                       Tag="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- 底部动作栏 — 与 StorageCleanWindow / ProcessSelectDialog 同构:分隔线 + 16,10 内边距 -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
            Padding="16,10">
      <Grid>
        <ui:Button x:Name="RefreshBtn" Content="{x:Static app:Strings.SysOptRefresh}"
                   Appearance="Secondary" Height="32" Padding="12,0" HorizontalAlignment="Left"
                   Click="RefreshBtn_Click"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <ui:Button x:Name="RestoreBtn" Content="{x:Static app:Strings.SysOptRestore}"
                     Appearance="Secondary" Height="32" Padding="12,0" Margin="0,0,8,0"
                     Click="RestoreBtn_Click">
            <ui:Button.Icon>
              <ui:SymbolIcon Symbol="ArrowReset24" FontSize="{DynamicResource FontSizeSubtitle}"/>
            </ui:Button.Icon>
          </ui:Button>
          <ui:Button x:Name="OneClickOptimizeBtn" Content="{x:Static app:Strings.SysOptOneClick}"
                     Appearance="Primary" Height="32" Padding="14,0"
                     Click="OneClickOptimize_Click">
            <ui:Button.Icon>
              <ui:SymbolIcon Symbol="Wand24" FontSize="{DynamicResource FontSizeSubtitle}"/>
            </ui:Button.Icon>
          </ui:Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
