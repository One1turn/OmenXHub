<ui:FluentWindow x:Class="OmenSuperHub.Views.StorageCleanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:OmenSuperHub"
        Title="{x:Static app:Strings.StorageCleanTitle}" Width="480" Height="560"
        MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="Transparent">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ponytail: Title 只给窗口/任务栏;实际渲染的是 Header —— 图标+标题自排才能控间距。
         Header 必须 IsHitTestVisible=False,否则 TitleBar 认为鼠标压在内容上,不发 HTCAPTION,拖不动。 -->
    <ui:TitleBar Style="{StaticResource OmenDialogTitleBar}" Grid.Row="0" Title="{x:Static app:Strings.StorageCleanTitle}"
                 ShowMinimize="False" ShowMaximize="False" ShowClose="True" CanMaximize="False">
      <ui:TitleBar.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
          <ui:SymbolIcon Symbol="Broom24" FontSize="{DynamicResource FontSizeSubheader}"
                         Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{x:Static app:Strings.StorageCleanTitle}" FontSize="{DynamicResource FontSizeTitle}"
                     FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </ui:TitleBar.Header>
    </ui:TitleBar>

    <!-- List -->
    <Grid Grid.Row="1" Margin="16,0,16,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid>
        <CheckBox x:Name="SelectAllBox" VerticalAlignment="Center" Padding="8,2"
                  Content="{x:Static app:Strings.BoostSelectAll}"
                  Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="SelectedTotalText" VerticalAlignment="Center" Margin="0,0,10,0"
                     FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <ui:Button Content="{x:Static app:Strings.StorageCleanRescan}" Height="32" Padding="12,0"
                     x:Name="RescanBtn" Click="Rescan_Click"/>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ItemsList" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource OmenListCard}" Padding="12,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSubtitle}"/>
                    <TextBlock Text="{Binding Description}" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" MinWidth="70"
                             TextAlignment="Right" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSubtitle}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="2"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
            Padding="16,10">
      <Grid>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <ui:Button x:Name="CleanBtn" Content="{x:Static app:Strings.StorageCleanRun}"
                   Appearance="Primary" HorizontalAlignment="Right" Height="32" Padding="14,0"
                   Click="CleanBtn_Click">
          <ui:Button.Icon>
            <ui:SymbolIcon Symbol="Delete24" FontSize="{DynamicResource FontSizeSubtitle}"/>
          </ui:Button.Icon>
        </ui:Button>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
